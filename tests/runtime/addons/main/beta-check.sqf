disableSerialization;
private _log={params ["_name","_ok"];diag_log format ["ATLAS_BETA_TEST %1: %2",_name,["FAIL","PASS"] select _ok]};
private _savedPrefs=[] call SICS_fnc_preferences;
ATLAS_voiceEnabled=false;ATLAS_bannersEnabled=false;
["NOTIFICATIONS"] call SICS_fnc_launchApp;
["centre_registered","NOTIFICATIONS" in SYNAPSE_apps] call _log;
["centre_controls",!isNull(findDisplay 87000 displayCtrl 2401)] call _log;
["CLEAR"] call SICS_fnc_notifications;
SICS_tab="MESSAGES";[] call SICS_fnc_osHome;
["MESSAGE","Home must not mark a message as read",""] call SICS_fnc_notify;
["home_preserves_unread",SICS_unread getOrDefault ["MESSAGES",0]==1] call _log;
["home_notice_unread",!(SICS_notificationHistory select -1 select 5)] call _log;
["NOTIFICATIONS"] call SICS_fnc_launchApp;
["centre_lists_history",lbSize(findDisplay 87000 displayCtrl 2401)==1] call _log;
["centre_details",ctrlText(findDisplay 87000 displayCtrl 2402) find "Home must not">=0] call _log;
["centre_open_chat",[] call SICS_fnc_noticeOpen && {SICS_osApp=="ATLAS"} && {SICS_tab=="MESSAGES"}] call _log;
["MESSAGE","Already reading this conversation",""] call SICS_fnc_notify;
["reading_marks_notice",SICS_notificationHistory select -1 select 5] call _log;
[] call SICS_fnc_osHome;
["ORDER","Order received",""] call SICS_fnc_notify;
["NOTIFICATIONS"] call SICS_fnc_launchApp;["READ_ALL"] call SICS_fnc_notifications;
["mark_all_read",SICS_notificationHistory findIf {!(_x select 5)}<0 && {count SICS_unread==0}] call _log;
for "_i" from 1 to 55 do {["INFO",format ["Bounded test %1",_i]] call SICS_fnc_notify};
["history_bounded_50",count SICS_notificationHistory==50] call _log;
["NOTIFICATIONS"] call SICS_fnc_launchApp;["CLEAR"] call SICS_fnc_notifications;
["clear_history",SICS_notificationHistory isEqualTo [] && {lbSize(findDisplay 87000 displayCtrl 2401)==0}] call _log;
private _seq=(missionNamespace getVariable ["ATLAS_noticeSequence",0])+1;
SICS_notificationHistory=[["MESSAGE","Revoked channel",diag_tickTime,"CH:REVOKED",-1,false,_seq]];ATLAS_noticeSelected=_seq;
["revoked_notice_refused",!([] call SICS_fnc_noticeOpen)] call _log;
SICS_notificationHistory=[["REPORT","Expired record",diag_tickTime,"",999999,false,_seq+1]];ATLAS_noticeSelected=_seq+1;
["expired_record_refused",!([] call SICS_fnc_noticeOpen)] call _log;
["SETTINGS"] call SICS_fnc_launchApp;["PREFERENCES"] call SICS_fnc_settings;
["preferences_controls",!isNull(findDisplay 87000 displayCtrl 2140) && {!isNull(findDisplay 87000 displayCtrl 2133)}] call _log;
["text",1.15] call SICS_fnc_preferences;["PREFERENCES"] call SICS_fnc_settings;
["text_large_applied",ATLAS_textScale==1.15] call _log;
["text",99] call SICS_fnc_preferences;
["invalid_scale_rejected",ATLAS_textScale==1.15] call _log;
["trails",false] call SICS_fnc_preferences;["labels",false] call SICS_fnc_preferences;
["declutter_preferences",!ATLAS_showTrails && {!ATLAS_showTrackLabels}] call _log;
private _diag=[] call SICS_fnc_diagnostics;
["diagnostics_version",_diag find "0.12.0-beta.2">=0] call _log;
["diagnostics_omit_uid",getPlayerUID player=="" || {_diag find getPlayerUID player<0}] call _log;
["CAMERA"] call SICS_fnc_launchApp;sleep 0.2;[] call SICS_fnc_cameraSnap;sleep 0.05;[] call SICS_fnc_osHome;sleep 0.6;
["capture_cancelled",!(missionNamespace getVariable ["ATLAS_captureBusy",false]) && {isNull ATLAS_photoCamera} && {isNil "ATLAS_captureEH"}] call _log;
private _bad=format ["P_%1_BAD_LENGTH",owner player];
[player,"PHOTO_BEGIN",[_bad,2,64,["Wrong length",getPosASL player,0,0,getPlayerUID player]],SICS_terminal] remoteExecCall ["SICS_fnc_server",2];sleep 0.2;
["photo_length_mismatch_rejected",!(_bad in ATLAS_serverPhotos)] call _log;
ATLAS_reportPhoto="PRIVATE_FIXTURE";SICS_pendingChatDraft="PRIVATE DRAFT";
["ATLAS"] call SICS_fnc_launchApp;SICS_tab="MESSAGES";[] call SICS_fnc_page;(findDisplay 87000 displayCtrl 106) ctrlSetText "PRIVATE DRAFT";
SICS_notificationHistory=[["MESSAGE","PRIVATE NOTICE",diag_tickTime,"",-1,false,1]];
SICS_savedAtlas set ["composer",["PRIVATE DRAFT"]];
[] call SICS_fnc_resetClient;sleep 0.2;
["reset_closes_device",isNull findDisplay 87000] call _log;
["reset_clears_records",SICS_localRecords isEqualTo [] && {SICS_clientChannels isEqualTo []}] call _log;
["reset_clears_notices",SICS_notificationHistory isEqualTo [] && {count SICS_unread==0}] call _log;
["reset_clears_drafts",count SICS_savedAtlas==0 && {SICS_pendingChatDraft==""}] call _log;
["reset_clears_photos",count ATLAS_photoMeta==0 && {ATLAS_reportPhoto==""} && {ATLAS_cameraSelected==""}] call _log;
private _oldGroup=group player;private _oldCallsign=groupId _oldGroup;
[objNull,"TABLET","HOME"] call SICS_fnc_open;
SICS_notificationHistory=[["INFO","Old side",diag_tickTime,"",-1,false,1]];
private _other=createGroup east;[player] joinSilent _other;sleep 2.3;
["actual_side_change_closes_ui",isNull findDisplay 87000 && {SICS_markerSide==east}] call _log;
["actual_side_change_clears_cache",SICS_notificationHistory isEqualTo [] && {count SICS_savedAtlas==0}] call _log;
if (isNull _oldGroup) then {_oldGroup=createGroup west;_oldGroup setGroupIdGlobal [_oldCallsign]};
[player] joinSilent _oldGroup;sleep 2.3;
["side_restore",SICS_markerSide==west] call _log;
{[_x,_savedPrefs select _forEachIndex] call SICS_fnc_preferences} forEach ["voice","banners","text","trails","labels"];
[objNull,"TABLET","HOME"] call SICS_fnc_open;
diag_log "ATLAS_BETA_TEST COMPLETE";
