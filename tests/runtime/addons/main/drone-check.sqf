disableSerialization;
private _log={params ["_name","_ok"];diag_log format ["ATLAS_DRONE_TEST %1: %2",_name,["FAIL","PASS"] select _ok]};
private _loadout=getUnitLoadout player;
player linkItem "B_UavTerminal";
private _uav=createVehicle ["B_UAV_02_dynamicLoadout_F",player getPos [80,0],[],0,"NONE"];
createVehicleCrew _uav;_uav allowDamage false;[] call cTab_fnc_updateLists;
["authorised_uav",_uav in cTabUAVlist] call _log;
if (isNull findDisplay 87000) then {[] call SICS_fnc_open};
["DRIVER",_uav] call SICS_fnc_droneControl;sleep 2;
diag_log format ["ATLAS_DRONE_TEST driver control=%1",UAVControl _uav];
["native_pilot_role",player in UAVControl _uav && {"DRIVER" in UAVControl _uav}] call _log;
(getConnectedUAVUnit player) action ["BackFromUAV"];sleep 0.6;
if (isNull findDisplay 87000) then {[] call SICS_fnc_open};
["GUNNER",_uav] call SICS_fnc_droneControl;sleep 2;
diag_log format ["ATLAS_DRONE_TEST gunner control=%1 weapons=%2",UAVControl _uav,_uav weaponsTurret [0]];
["native_turret_role",player in UAVControl _uav && {"GUNNER" in UAVControl _uav}] call _log;
["armed_drone_available",(weapons _uav) isNotEqualTo []] call _log;
(getConnectedUAVUnit player) action ["BackFromUAV"];sleep 0.6;
player connectTerminalToUAV objNull;player setUnitLoadout _loadout;
[] call SICS_fnc_open;[] call SICS_fnc_osHome;
diag_log "ATLAS_DRONE_TEST COMPLETE";
