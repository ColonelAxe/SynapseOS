if (isNull findDisplay 87000) then {[] call SICS_fnc_open};
sleep 2;
private _log={params ["_name","_ok"]; diag_log format ["SICS_TEST %1: %2",_name,["FAIL","PASS"] select _ok]};
["display",!isNull findDisplay 87000] call _log;
{
    SICS_tab=_x; [] call SICS_fnc_page;
    sleep 0.5;
    [format ["tab_%1",_x],!isNull (findDisplay 87000 displayCtrl 100)] call _log;
} forEach ["MESSAGES","C2","REPORTS","ISR","TOC"];
SICS_tab="MESSAGES"; [] call SICS_fnc_page;
(findDisplay 87000 displayCtrl 106) ctrlSetText "SICS automated local message test";
["MESSAGES"] call SICS_fnc_submit;
sleep 2;
["message_roundtrip",(missionNamespace getVariable ["SICS_localRecords",[]]) findIf {(_x select 4)=="SICS automated local message test"} >= 0] call _log;
SICS_tab="C2"; [] call SICS_fnc_page;
(findDisplay 87000 displayCtrl 106) ctrlSetText "SICS automated order test";
["C2"] call SICS_fnc_submit;
sleep 2;
private _orders=(missionNamespace getVariable ["SICS_localRecords",[]]) select {(_x select 2)=="C2"};
["order_roundtrip",count _orders>0] call _log;
if (count _orders>0) then {SICS_selectedRecord=(_orders select (count _orders-1)) select 0; ["ACK"] call SICS_fnc_submit};
sleep 2;
["order_ack",(missionNamespace getVariable ["SICS_localRecords",[]]) findIf {(_x select 2)=="C2" && {count (_x select 10)>0}} >= 0] call _log;
SICS_tab="REPORTS"; [] call SICS_fnc_page;
(findDisplay 87000 displayCtrl 106) ctrlSetText "SALUTE / automated local report test";
["REPORTS"] call SICS_fnc_submit;
sleep 2;
["report_roundtrip",(missionNamespace getVariable ["SICS_localRecords",[]]) findIf {(_x select 2)=="REPORTS"} >= 0] call _log;
(findDisplay 87000 displayCtrl 33) ctrlSetText "ATLAS TEST";
["CALLSIGN"] call SICS_fnc_submit;
sleep 2;
["callsign",groupId group player=="ATLAS TEST"] call _log;
SICS_tab="OVERVIEW"; [] call SICS_fnc_page;
diag_log "SICS_TEST COMPLETE";
hint "SICS smoke checks complete. Results written to the RPT.";
